NODE_ENV=production
HOST=127.0.0.1
PORT=3006
STATIC_SITE_DIR=/srv/retrozetro/current/front-end/dist
UPLOAD_ROOT=/srv/retrozetro/shared/uploads

MONGODB_URI=mongodb://retrozetro_app:replace-with-a-url-encoded-random-password@127.0.0.1:27017/retrozetro?authSource=retrozetro

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET_PREVIOUS=
INTERNAL_DIAGNOSTICS_KEY=replace-with-a-different-32-character-random-value
PUBLIC_SITE_ORIGIN=https://retrozetrocomics.com
ALLOWED_ORIGINS=
TRUSTED_PROXY_IPS=127.0.0.1,::1

# To use Vault instead of MONGODB_URI, remove MONGODB_URI and configure all
# of VAULT_ADDR, VAULT_ROLE_ID, and VAULT_SECRET_ID together.
# VAULT_ADDR=https://vault.example.com
# VAULT_ROLE_ID=replace-with-rotated-role-identifier
# VAULT_SECRET_ID=replace-with-rotated-secret-identifier
# VAULT_MONGODB_SECRET_PATH=secret/data/retrozetro/mongodb
# VAULT_ALLOW_HTTP=false

CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=RetroZetro Comics
CONTACT_TO_EMAIL=contacts@jacobdanderson.net
CONTACT_BCC_EMAIL=
CONTACT_USE_SENDMAIL=false
CONTACT_SENDMAIL_PATH=
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

STORAGE_KEY_PREFIX=content
LOCAL_UPLOAD_PUBLIC_BASE_URL=/uploads
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=
