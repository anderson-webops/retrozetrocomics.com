	"scripts": {
		"build": "vite-ssg build",
		"dev": "vite --port 3333 --open",
		"start": "vite --port 3333 --open --host",
		"serve": "vite --port 3333 --open --host",
		"preview": "vite preview",
		"preview-https": "serve dist",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p cypress/tsconfig.json --noEmit",
		"up": "taze major -I",
		"lint": "eslint \"src/**/*.{js,ts,vue}\" \"test/**/*.ts\" \"cypress/**/*.ts\" cypress.config.ts vite.config.mts uno.config.ts",
		"lint-fix": "eslint \"src/**/*.{js,ts,vue}\" \"test/**/*.ts\" \"cypress/**/*.ts\" cypress.config.ts vite.config.mts uno.config.ts --fix"
	},
