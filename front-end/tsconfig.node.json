{
	"compilerOptions": {
		"composite": true,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node", "vite/client"],
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"cypress.config.ts",
		"vite.config.mts",
		"vite.ssr.config.mts",
		"uno.config.ts",
		"scripts/**/*.mts",
		"src/utils/ssgHead.ts"
	]
}
