{
	"name": "retrozetro-monorepo",
	"type": "module",
	"version": "2.3.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Monorepo for retro zetro comics",
	"author": "Jacob Anderson",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end",
		"back-end"
	],
	"scripts": {
		"a11y": "node scripts/a11y-smoke.mjs",
		"admin": "npm run -w back-end admin --",
		"audit": "npm audit --workspaces --audit-level=low",
		"audit:production": "npm audit --workspaces --omit=dev --audit-level=low",
		"audit:signatures": "npm audit signatures",
		"build": "npm run -w front-end build && npm run -w back-end build && npm run release:metadata",
		"build:netlify": "npm run -w front-end build && npm run release:metadata && node scripts/write-netlify-headers.mjs",
		"clean": "node scripts/clean.mjs",
		"dev": "npm run -w front-end dev",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run lint:root && npm run -w front-end lint && npm run -w back-end lint",
		"lint:root": "eslint \"scripts/**/*.mjs\" eslint.config.js",
		"lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"postinstall": "simple-git-hooks",
		"release:metadata": "node scripts/write-release-metadata.mjs",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"serve": "npm run -w front-end serve",
		"test": "npm run -w front-end test && npm run -w back-end test",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"up": "taze major -I && npm run -w front-end up && npm run -w back-end up",
		"verify:dependency-graph": "node scripts/verify-dependency-graph.mjs",
		"verify:deploy-assets": "node scripts/verify-deploy-assets.mjs",
		"verify:direct-runtime": "node scripts/direct-runtime-smoke.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"verify:production-install": "node scripts/verify-production-install.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@unocss/eslint-plugin": "^66.6.7",
		"axe-core": "^4.12.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.5.0",
		"js-beautify": "2.0.3",
		"lint-staged": "^17.2.0",
		"prettier": "^3.8.3",
		"puppeteer": "^25.4.0",
		"simple-git-hooks": "^2.13.1",
		"taze": "^19.16.0",
		"typescript": "^6.0.3"
	},
	"simple-git-hooks": {
		"pre-commit": "test -x ./node_modules/.bin/lint-staged || { echo 'lint-staged is not installed. Run npm install.'; exit 1; }; ./node_modules/.bin/lint-staged"
	},
	"lint-staged": {
		"*.{js,ts,vue,mjs,cjs}": [
			"eslint --fix"
		]
	},
	"overrides": {
		"defu": "6.1.6",
		"picomatch": "4.0.4",
		"anymatch": {
			"picomatch": "2.3.2"
		},
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"readdirp": {
			"picomatch": "2.3.2"
		},
		"vite": "^8.2.0",
		"vue-router": "^5.0.4",
		"follow-redirects": "1.16.0",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.15.2"
		},
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4",
		"js-yaml": "4.3.0",
		"postcss": "8.5.24",
		"shell-quote": "1.10.0",
		"svgo": "4.0.2",
		"tar": "7.5.22",
		"valibot": "1.4.2",
		"js-beautify": "2.0.3"
	},
	"allowScripts": {
		"argon2@0.45.1": true,
		"cypress@15.19.0": false,
		"esbuild@0.28.1": true,
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.4.0": false,
		"simple-git-hooks@2.13.1": true,
		"unrs-resolver@1.12.2": true,
		"vue-demi@0.14.10": true
	}
}
