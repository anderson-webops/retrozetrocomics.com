{
	"name": "back-end",
	"version": "2.10.2",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"admin": "node -r dotenv/config dist/admin-lifecycle.js",
		"admin:dev": "tsx -r dotenv/config src/admin-lifecycle.ts",
		"build": "tsc -p tsconfig.json --incremental false",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"lint": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\" --fix",
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "vitest run",
		"start": "node dist/server.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"up": "taze major -I"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"overrides": {
		"vite": "8.2.0",
		"postcss": "8.5.26",
		"body-parser": "$body-parser",
		"brace-expansion": "5.0.9",
		"esbuild": "$esbuild",
		"js-yaml": "4.3.1",
		"qs": "6.17.1"
	},
	"dependencies": {
		"@simplewebauthn/server": "^13.3.2",
		"argon2": "^0.45.1",
		"cookie-session": "^2.1.1",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.1.0",
		"mongoose": "^9.11.2",
		"multer": "^2.5.0",
		"nodemailer": "^10.1.2",
		"parse5": "^8.0.1",
		"readline-sync": "^1.4.10",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cookie-session": "^2.0.49",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.0",
		"@types/readline-sync": "^1.4.8",
		"eslint": "^10.12.0",
		"globals": "^17.9.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.11"
	}
}
