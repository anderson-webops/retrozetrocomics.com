{
	"name": "back-end",
	"version": "2.10.7",
	"private": true,
	"packageManager": "npm@12.2.2",
	"engines": {
		"node": ">=26.13.1 <27",
		"npm": ">=12.2.2 <13"
	},
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"admin": "node -r dotenv/config dist/admin-lifecycle.js",
		"admin:dev": "tsx -r dotenv/config src/admin-lifecycle.ts",
		"build": "tsc -p tsconfig.json --incremental false",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"lint": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\" --fix",
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "vitest run",
		"start": "node dist/server.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"up": "taze major -I"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@simplewebauthn/server": "^14.1.0",
		"argon2": "^0.45.1",
		"cookie-session": "^2.1.1",
		"dotenv": "^18.0.10",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.4",
		"helmet": "^8.1.0",
		"mongoose": "^9.12.1",
		"multer": "^2.5.0",
		"nodemailer": "^10.6.0",
		"parse5": "^8.0.1",
		"readline-sync": "^1.4.10",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cookie-session": "^2.0.49",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.0",
		"@types/readline-sync": "^1.4.8",
		"eslint": "^10.15.0",
		"globals": "^17.9.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
