NODE_ENV=development
HOST=127.0.0.1
PORT=3006

MONGODB_URI=mongodb://localhost:27017/retrozetro

# Use cryptographically random values of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated prior secrets allow an orderly cookie-signing-key rotation.
SESSION_SECRET_PREVIOUS=
INTERNAL_DIAGNOSTICS_KEY=

PUBLIC_SITE_ORIGIN=https://retrozetrocomics.com
# Exact origins only; wildcards and paths are rejected.
ALLOWED_ORIGINS=
# Exact reverse-proxy source addresses only. Production accepts loopback values.
TRUSTED_PROXY_IPS=

# Vault is used only when all three primary values are present. Partial
# configuration is rejected, and a configured Vault lookup never falls back.
VAULT_ADDR=https://vault.example.com
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MONGODB_SECRET_PATH=secret/data/retrozetro/mongodb
# Only for a deliberately trusted private HTTP Vault endpoint.
VAULT_ALLOW_HTTP=false

CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=RetroZetro Comics
CONTACT_TO_EMAIL=contacts@jacobdanderson.net
CONTACT_BCC_EMAIL=
CONTACT_USE_SENDMAIL=false
CONTACT_SENDMAIL_PATH=
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

STORAGE_KEY_PREFIX=content
LOCAL_UPLOAD_PUBLIC_BASE_URL=/uploads
# Production requires an absolute persistent path outside the release checkout.
UPLOAD_ROOT=

# Future AWS media rollout
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=
